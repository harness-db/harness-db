# Screening exports are regenerated by scripts/export_screening.py; the RIS is large
data/screening/rayyan_import.ris
data/screening/*.log
data/screening/human_queue.js

# Fetched full texts and caches: large, third-party content; regenerate with scripts/fetch_fulltext.py
data/fulltext/
data/raw/cache/

# autopilot scratch and logs
data/screening/_autopilot_*_ids.csv
data/screening/autopilot*.log

# Scratch inputs and side-by-side experiment outputs from screening runs (prefixed _)
data/screening/_*
data/screening/autopilot_console*
data/screening/fulltext_audit.js
data/coded/_v2_a/
data/coded/_v2_b/
data/coded/autopilot.lock

# Dataset release builds (scripts/release_dataset.py); published to Zenodo, not committed
release/

# Corpus ablation harvest: text windows are excerpts of third-party sources (regenerable); logs and lock are scratch
data/analysis/corpus_ablation/windows.jsonl
data/analysis/corpus_ablation/*.log
data/analysis/corpus_ablation/extract.lock
